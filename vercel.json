{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "progresstrade\\.vercel\\.app" }],
      "destination": "https://progresstrade.bg/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www\\.progresstrade\\.bg" }],
      "destination": "https://progresstrade.bg/:path",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:dir+/index.html", "destination": "/:dir+/", "permanent": true },
    { "source": "/izkupuvane/", "destination": "/kakvo-izkupuvame/", "permanent": true },
    { "source": "/izkupuvane/tehnologichen-skrap-boya/", "destination": "/izkupuvane/tehnologichen-otpadak/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(css|js|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(images|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/(favicon.ico|favicon-32.png|favicon-64.png|favicon-96.png|apple-touch-icon.png|icon-192.png|icon-512.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
